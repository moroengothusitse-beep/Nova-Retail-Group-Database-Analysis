.....3.5 Rank regions by total sales. Use the RANK() or ROW_NUMBER() window function. Show Region, Total Sales, Total Orders, and Rank.

SELECT c.Region, SUM(s.TotalSales) AS Total_Sales, COUNT(s.OrderID) AS Total_Orders,RANK() OVER (ORDER BY SUM(s.TotalSales) DESC) AS Rank
FROM sales AS s
JOIN customers AS c ON s.CustomerID = c.CustomerID
GROUP BY c.Region
ORDER BY Rank ASC

Business Intelligence Questions

.....4.1 Analyze whether highly satisfied customers (rating 4-5) make more repeat purchases than less satisfied customers (rating 1-3). Show satisfaction level groups, average number of orders per customer, and total customers in each group.

WITH CustomerSatisfaction AS (
SELECT CustomerID, AVG(Rating) AS avg_customer_rating, 
    CASE 
            WHEN AVG(Rating) >= 4 THEN 'Highly Satisfied (4-5)'
            WHEN AVG(Rating) >= 1 AND AVG(Rating) < 4 THEN 'Less Satisfied (1-3)'
            ELSE 'No Rating Data'
    END AS satisfaction_level
    FROM customer_feedback
    GROUP BY CustomerID
),
CustomerOrderCounts AS (
    SELECT CustomerID, COUNT(DISTINCT OrderID) AS total_orders
    FROM sales
    GROUP BY CustomerID
)
SELECT s.satisfaction_level, COUNT(DISTINCT s.CustomerID) AS total_customers, ROUND(AVG(o.total_orders), 2) AS avg_orders_per_customer
FROM CustomerSatisfaction s
JOIN CustomerOrderCounts o 
    ON s.CustomerID = o.CustomerID
WHERE s.satisfaction_level IN ('Highly Satisfied (4-5)', 'Less Satisfied (1-3)')
GROUP BY s.satisfaction_level
ORDER BY avg_orders_per_customer DESC

.....4.2 Examine the relationship between discount percentage and profit. Create discount bands (0%, 1-10%, 11-20%, 21-30%) and show total sales, total profit, and profit margin for each band.

WITH discount_bands AS (
SELECT *,
CASE 
            WHEN DiscountPercent = 0 THEN '0%'
            WHEN DiscountPercent BETWEEN 11 AND 20 THEN '11-20%'
            WHEN DiscountPercent BETWEEN 21 AND 30 THEN '21-30%'
END AS discount_band
FROM sales
)
SELECT discount_band,SUM(TotalSales) AS total_sales, SUM(Profit) AS total_profit, ROUND(SUM(Profit) / NULLIF(SUM(TotalSales), 0) * 100, 2) AS profit_margin_percentage
FROM discount_bands
GROUP BY discount_band
ORDER BY profit_margin_percentage DESC

..... 4.3 Identify underperforming products (bottom 5 by total revenue) and analyze whether they should be discontinued. Consider sales volume, profit margin, and customer ratings.

SELECT p.ProductID, p.ProductName, SUM(s.Quantity) AS total_sales_volume, SUM(s.Quantity * s.UnitPrice) AS total_revenue, ROUND((p.UnitPrice - p.CostPrice) / NULLIF(p.UnitPrice, 0) * 100, 2) AS avg_profit_margin, AVG(r.Rating) AS avg_customer_rating
FROM products p
JOIN sales s ON p.ProductID = s.ProductID
LEFT JOIN customer_feedback r ON p.ProductID = r.ProductCategory
GROUP BY p.ProductID, p.ProductName, p.UnitPrice, p.CostPrice
ORDER BY total_revenue ASC
LIMIT 5

