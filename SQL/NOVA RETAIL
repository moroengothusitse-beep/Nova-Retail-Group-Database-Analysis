Select 'Products' As TableName, COUNT(*) As Records
From Products UNION ALL 
SELECT 'Customers', COUNT(*) FROM UNION ALL
Select 'Sales', COUNT(*) From Sales UNION ALL
Select'CustomerFeedback', COUNT(*) From Customer_feedback 

Basic SQL Queries

.....1.1 List all products in the Electronics category. Show ProductID, ProductName, and UnitPrice. Order by price from highest to lowest.

Select ProductID, ProductName, UnitPrice
FROM products
WHERE category = 'Electronics'
ORDER BY UnitPrice DESC

.....1.2 How many customers are in each region? Show Region and the count of customers.

SELECT Region, COUNT(*) AS customer_count
FROM customers
GROUP BY Region

.....1.3 Show the 10 most recent orders. Display OrderID, OrderDate, and TotalSales.

SELECT OrderID, OrderDate, TotalSales
FROM sales
ORDER BY OrderDate DESC
LIMIT 10

..... 1.4 Find all products with a UnitPrice less than R1000. Show ProductName, Category, and UnitPrice.

select productID, ProductName, Category, UnitPrice
from products
where UnitPrice <1000

..... 1.5 Count how many feedback responses exist for each Satisfaction level. Order by count descending.

SELECT Satisfaction, COUNT(*) AS feedback_count
FROM customer_feedback
GROUP BY Satisfaction
ORDER BY feedback_count DESC

Intermediate SQL Queries

..... 2.1 Calculate total sales revenue for each product category. Show Category, Total Revenue, and Total Profit. Order by revenue descending.

SELECT p.Category AS Category,
ROUND(SUM(s.TotalSales),2) AS Total_Revenue,
ROUND(SUM(s.Profit),2) AS Total_Profit
FROM sales AS s
JOIN products AS p ON s.ProductID = p.ProductID
GROUP BY p.Category
ORDER BY Total_Revenue DESC

..... 2.2 Find the top 5 customers by total purchase amount. Show CustomerID, Customer Name (FirstName + LastName), and Total Spent. Hint: Use CONCAT or + to combine names.

SELECT c.CustomerID,CONCAT(c.FirstName, ' ', c.LastName) AS Customer_Name,SUM(s.TotalSales) AS Total_Spent
FROM sales AS s
JOIN customers AS c ON s.CustomerID = c.CustomerID
GROUP BY c.CustomerID, c.FirstName, c.LastName
ORDER BY Total_Spent DESC
LIMIT 5

..... 2.3 Show total sales by month for 2024. Display Year, Month (as number), and Total Sales. Order chronologically.

SELECT YEAR(OrderDate) AS Year,MONTH(OrderDate) AS Month,SUM(TotalSales) AS Total_Sales
FROM sales
WHERE OrderDate BETWEEN '2024-01-01' AND '2024-12-31'
GROUP BY YEAR(OrderDate), MONTH(OrderDate)
ORDER BY Year, Month ASC

..... 2.4 Compare Online vs Store performance. Show Channel, Number of Orders, Average Order Value, and Total Revenue.

SELECT Channel,COUNT(OrderID) AS Order_Number,AVG(TotalSales) AS Average_Order_Value,SUM(TotalSales) AS Total_Revenue
FROM sales
GROUP BY Channel
ORDER BY Total_Revenue DESC 

..... 2.5 For each product category, show the average customer rating. Include Category, Average Rating, and Number of Reviews. Only show categories with at least 50 reviews.

SELECT ProductCategory AS Category,AVG(Rating) AS Average_Rating,COUNT(FeedbackID) AS Number_Of_Reviews
FROM customer_feedback
GROUP BY ProductCategory
HAVING COUNT(FeedbackID) >= 50


Advanced SQL Queries

..... 3.1 Find the product with the highest total sales in each category. Show Category, ProductName, and Total Revenue for that product. Use a window function or subquery.

WITH RankedProducts AS (
    SELECT p.Category, p.ProductName, SUM(s.TotalSales) AS Total_Revenue, RANK() OVER (PARTITION BY p.Category ORDER BY SUM(s.TotalSales) DESC) AS rank
    FROM sales AS s
    JOIN products AS p ON s.ProductID = p.ProductID
    GROUP BY p.Category, p.ProductName
)
SELECT Category, ProductName, Total_Revenue
FROM RankedProducts
WHERE rank = 1
ORDER BY Total_Revenue DESC

..... 3.2 Create a query showing each customer's total purchases, number of orders, and average order value. Also include their region and primary channel. Only show customers with more than 3 orders. Order by total purchases descending.

SELECT c.CustomerID, c.Region, c.Channel, SUM(s.TotalSales) AS Total_Purchases, COUNT(s.OrderID) AS Number_Of_Orders, AVG(s.TotalSales) AS Avg_Order_Value
FROM sales AS s
JOIN customers AS c ON s.CustomerID = c.CustomerID
GROUP BY c.CustomerID, c.Region, c.Channel
HAVING COUNT(s.OrderID) > 3
ORDER BY Total_Purchases DESC

..... 3.3 Calculate the profit margin percentage for each product. Show ProductName, Category, Total Sales, Total Profit, and Profit Margin %. Order by profit margin descending. Formula: (Profit / Sales) * 100

SELECT p.ProductName,p.Category,SUM(s.TotalSales) AS TotalSales, SUM(s.Profit) AS TotalProfit, ROUND((SUM(s.Profit) / SUM(s.TotalSales)) * 100, 2) AS Profit_Margin_Percentage
FROM sales AS s
JOIN products AS p ON s.ProductID = p.ProductID
GROUP BY p.ProductName, p.Category
ORDER BY Profit_Margin_Percentage DESC

..... 3.4 Compare sales between 2023 and 2024. Show the total sales for each year and calculate the growth percentage. Use a CTE or subquery.
WITH 
sales_2023 AS (
  SELECT SUM(TotalSales) AS TotalSales2023
  FROM sales
  WHERE YEAR(OrderDate) = 2023), 
sales_2024 AS (
  SELECT SUM(TotalSales) AS TotalSales2024
  FROM sales
  WHERE YEAR(OrderDate) = 2024)
SELECT 
